{
  "name": "@gate8/runtime",
  "version": "0.1.0",
  "description": "Runtime / orchestrator layer: Case Instance creation flow, typed generated-snapshot handling, and the loader/repository contracts. Pure — no Supabase, DB, or HTTP inside (Phase 14 design D13).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate8/game-rules": "0.1.0",
    "@gate8/shared-types": "0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
