{
  "name": "@gate8/game-rules",
  "version": "0.1.0",
  "description": "Rule / condition engine (AST, parser, contexts, evaluator) and the seeded case generation pipeline (deterministic per-step generators composed over version-pinned content snapshots).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate8/shared-types": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
